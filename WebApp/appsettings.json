{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "JwtSettings": {
    "SecretKey": "YourSuperSecretKeyThatIsAtLeast32CharactersLong!",
    "Issuer": "WebApp",
    "Audience": "WebApp",
    "ExpirationInMinutes": 60
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=WebAppDb;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "ElectHangfire": {
    "IsEnable": true,
    "Url": "/developers/job",
    "BackToUrl": "/",
    "AccessKey": "",
    "Provider": "SqlServer",
    "DbConnectionString": "Server=(localdb)\\mssqllocaldb;Database=WebAppDb;Trusted_Connection=True;MultipleActiveResultSets=true",
    "StatsPollingInterval": 3000
  }
}
